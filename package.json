{
  "name": "class-platform",
  "devDependencies": {
    "@caioms/biomejs-config": "latest",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "turbo": "^2.8.14",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.5",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:cov": "turbo run test:cov",
    "test:debug": "turbo run test:debug",
    "test:watch": "turbo run test:watch",
    "format": "biome format --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "biome:check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
    "check-types": "turbo run check-types",
    "prepare": "husky"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
