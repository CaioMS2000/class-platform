{
  "name": "main-api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false"
  },
  "bun": {
    "test": {
      "pattern": ["**/*.spec.ts", "**/*.test.ts"],
      "coverage": {
        "enabled": true
      }
    }
  },
  "dependencies": {
    "@node-rs/argon2": "^2.0.2",
    "@repo/core": "*",
    "arctic": "^3.7.0",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "jose": "^6.2.2",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@johanblumenberg/ts-mockito": "^1.0.52",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "bun-types": "^1.3.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
