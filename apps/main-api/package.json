{
  "name": "main-api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test",
    "test:e2e": "bash -c 'bun test --preload src/test/setup-e2e.ts --max-concurrency 1 $(find ./src -name \"*.e2e-spec.ts\")'",
    "test:watch": "bun test --watch",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --inspect --logHeapUsage --threads=false"
  },
  "bun": {
    "test": {
      "pattern": ["**/*.spec.ts", "**/*.test.ts"],
      "coverage": {
        "enabled": true
      }
    }
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.2.3",
    "@node-rs/argon2": "^2.0.2",
    "@repo/core": "*",
    "@scalar/hono-api-reference": "^0.10.4",
    "arctic": "^3.7.0",
    "awilix": "^13.0.3",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.45.1",
    "hono": "^4.12.9",
    "hono-openapi": "^1.3.0",
    "jose": "^6.2.2",
    "pg": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@johanblumenberg/ts-mockito": "^1.0.52",
    "@types/bun": "latest",
    "@types/pg": "^8.20.0",
    "bun-types": "^1.3.10",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
